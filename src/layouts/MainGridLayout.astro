---
import BackToTop from "@components/control/BackToTop.astro";
import WallpaperToggle from "@components/control/WallpaperToggle.astro";
import Footer from "@components/Footer.astro";
import Wallpaper from "@components/misc/Wallpaper.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import type { OgImage } from "../utils/og-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogImage?: OgImage;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	ogImage,
	headings = [],
} = Astro.props;
// 壁纸优先于顶部横幅：两者同时开启时只渲染壁纸
const bannerEnabled = siteConfig.banner.enable && !siteConfig.wallpaper?.enable;
const wallpaper = siteConfig.wallpaper?.enable
	? siteConfig.wallpaper
	: undefined;

const hasBannerCredit = bannerEnabled && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = bannerEnabled
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} ogImage={ogImage}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<!-- 无宽度过渡：顶栏布局与正文一起瞬切，宽度动画由 Layout.astro 的 O2 脚本以 transform 伪装（见 transition.css）；
     这里的 transition-opacity 只服务于壁纸欣赏模式的淡出，属性表不含宽度，不与 O2 冲突 -->
<div id="top-row" class="z-50 pointer-events-none relative max-w-[var(--page-width)] px-0 md:px-4 mx-auto transition-opacity duration-700" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{bannerEnabled && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Site-wide wallpaper background, outside the swup containers so it persists across navigations -->
{wallpaper && <Wallpaper config={wallpaper} />}
{/* 开关与 #wallpaper 同层：既在 Swup 容器外，也不在任何会被 inert 的容器内。理由见组件顶部注释 */}
{wallpaper && <WallpaperToggle />}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- TOC 导轨：挂在主面板包裹层内、inset-0 铺满以继承包裹层高度（其唯一在流子元素是 #main-panel，
         故高度 = 正文高度），sticky 的吸附行程因此与左侧 #sidebar-sticky 的容器（同一网格行）同起同止。
         必须放在 #main-panel 之前，让正文与 BackToTop 绘制于其上；全尺寸层 pointer-events-none，仅导轨恢复事件 -->
    <div class="absolute inset-0 pointer-events-none hidden 2xl:block">
        <div id="toc-panel" class="relative h-full max-w-[var(--page-width)] mx-auto transition-all duration-700">
            <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 bottom-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
                {"toc-hide": bannerEnabled}]}
            >
                <!-- sticky top-4：吸附位与左侧 #sidebar-sticky（sticky top-4）平齐；
                     初始静位 = 包裹层顶部（无 banner 时 5.5rem），与左侧栏卡片最高点对齐，随页面上移越过 top-4 后吸附 -->
                <div id="toc-inner-wrapper" class="sticky top-4 pointer-events-auto w-[var(--toc-width)] max-h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                    <div id="toc" class="w-full h-full transition-swup-fade ">
                        <div class="h-8 w-full"></div>
                        <TOC headings={headings}></TOC>
                        <div class="h-8 w-full"></div>
                    </div>
                </div>
            </div>

            {/* #toc needs to exist for Swup to work normally */}
            {!siteConfig.toc.enable && <div id="toc"></div>}
        </div>
    </div>
    <!-- 无过渡类：页宽收窄必须瞬切，动画由 Layout.astro 的 FLIP 脚本以 transform 承担（见 transition.css） -->
    <div id="main-panel" class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-0 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>
</Layout>
