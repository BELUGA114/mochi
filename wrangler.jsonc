{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mochi",
	// 锁定 Workers 运行时行为的基准日期，升级 wrangler 时不要随手改动
	"compatibility_date": "2026-08-30",
	"routes": [
		// 自定义域名，要求 cobweb11.top 这个 zone 在同一个 Cloudflare 账户下
		{ "pattern": "blog.cobweb11.top", "custom_domain": true }
	],
	"main": "worker/index.ts",
	"assets": {
		// 纯静态站点产物；Worker 通过 ASSETS binding 改道到其中的 .md 文件
		"directory": "./dist",
		"binding": "ASSETS",
		// 只让 Worker 抢先处理文章路径，其余路径仍走默认的资产优先
		"run_worker_first": ["/posts/*"]
	}
}
